VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# Spark-compatible direct Groq integration. VITE keys are public in the browser.
# Hiding the Groq key requires a separate backend/proxy outside this Firebase app.
VITE_AI_PROVIDER=mock
VITE_AI_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
VITE_GROQ_API_KEY=
VITE_USE_EMULATORS=false
